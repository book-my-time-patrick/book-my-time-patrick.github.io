{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invited-booking-api-local",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "FRONTEND_ORIGIN": "http://127.0.0.1:5173", "SITE_ORIGIN": "http://127.0.0.1:5173" },
  "d1_databases": [{ "binding": "DB", "database_name": "invited-booking-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }]
}
