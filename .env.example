# 仅前端 API 地址会进入静态构建。此文件只放占位值。
# GitHub Pages 构建时替换为 https://你的API域名/api。
# 同域服务器部署使用 /api。
VITE_API_BASE_URL=/api

# Node 备用服务的前端源，必须精确到协议、域名、端口。
FRONTEND_ORIGIN=http://127.0.0.1:3000
SITE_ORIGIN=http://127.0.0.1:3000
PORT=3000
DATABASE_PATH=./.local/app.sqlite
# 仅在Node服务不向公网暴露、由可信HTTPS反代访问时启用。
TRUST_PROXY=0
# 用 npm run prepare:local 生成本机密钥和限时首次初始化码，勿填入公开前端变量。
# Node 备用部署需从本机生成的 .local/node-secrets.env 安全复制以下变量。
DATA_ENCRYPTION_KEY=
SETUP_TOKEN_HASH=
SETUP_EXPIRES_AT=

# Docker 备用部署的自有域名，不含 https://。
SITE_DOMAIN=booking.example.com
