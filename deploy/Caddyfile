{$SITE_DOMAIN} {
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
    reverse_proxy app:3000
}
